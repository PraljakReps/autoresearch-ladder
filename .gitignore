# Raw per-run outputs (timestamped dirs, one per `python run.py` invocation).
# Wrap-time consolidated artifacts live under levels/LN_<name>/{summary/,figures/,
# RESULTS.md,results.tsv} and ARE tracked — see CLAUDE.md "Wrap convention".
results/
data/
logs/
*.log

# Model weights / large artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5
*.npz

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Venvs (live outside the repo on /workspace/envs/, but guard anyway)
.venv/
venv/
env/.venv/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# Session state — per-pod, ephemeral, not part of the repo
agent-docs/handoffs/
agent-docs/session-handoff.md
